    def create_element(
        self,
        name: str,
        *,
        group: str = "CUSTOM",
        properties: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        """Dynamically allocate and configure a new particle element.

        Properties accepted inside *properties*:

        ======     =========================================
        Key        Description
        ======     =========================================
        Name       Display name in menus (str)
        Type       Element type bitmask (int)
        Colour     RGBA array [R, G, B, A] (0-255 each)
        Color      Alias for Colour
        Advection  Air-follow coefficient 0..1 (float)
        AirDrag    Air drag coefficient (float)
        AirLoss    Air loss coefficient (float)
        Loss       General loss coefficient (float)
        Collision  Collision threshold (float)
        Gravity    Downward acceleration (float)
        NewtonianNewtonian gravity flag (float)
        Diffusion  Random walk intensity 0..1 (float)
        HotAir     Buoyancy when heated (float)
        Falldown   Override gravity direction (int)
        Flammable  Ignition chance 0-100 (int)
        Explosive  Explosion risk 0-100 (int)
        Meltable   Melting flag (int)
        Hardness   Hardness (int)
        Weight     Weight class (int)
        TemperatureDefault initial temperature (float)
        MenuVisibleMenu visibility (bool)
        ======     =========================================

        Parameters
        ----------
        name : str
            Unique element name identifier (will be uppercased).
        group : str
            Element group (default ``"CUSTOM"``).
        properties : dict | None
            Element property dictionary (see table above).

        Returns
        -------
        dict
            Server response with ``id`` (numeric element ID) and
            ``identifier`` (e.g. ``"CUSTOM_PT_FOOBAR"``).
        """
        payload: dict[str, Any] = {
            "action": "createElement",
            "group": group.upper(),
            "name": name.upper(),
        }
        if properties is not None:
            payload["properties"] = properties
        return self._post(payload)

    def set_field_region(
        self,
        field: str,
        *,
        x1: int = 0,
        y1: int = 0,
        x2: int | None = None,
        y2: int | None = None,
        value: float,
    ) -> dict[str, Any]:
        """Set a uniform field value over a rectangular region.

        Supports ``"temp"``, ``"temperature"``, ``"pressure"``, ``"velocityX"``,
        and ``"velocityY"`` (or ``"vx"`` / ``"vy"``).

        Parameters
        ----------
        field : str
            Field name to modify.
        x1 : int
            Left edge of region (default 0).
        y1 : int
            Top edge of region (default 0).
        x2 : int | None
            Right edge of region (defaults to grid width - 1).
        y2 : int | None
            Bottom edge of region (defaults to grid height - 1).
        value : float
            Value to set across the entire region.

        Returns
        -------
        dict
            Server response with ``field`` and ``cells`` (number of cells modified).
        """
        end_x = x1 if x2 is None else x2
        end_y = y1 if y2 is None else y2
        if not (0 <= x1 <= end_x < 153 and 0 <= y1 <= end_y < 96):
            raise ValueError("field region outside cell bounds")
        return self._post({
            "action": "setFieldRegion",
            "field": field.lower(),
            "x": x1,
            "y": y1,
            "w": end_x - x1 + 1,
            "h": end_y - y1 + 1,
            "value": value,
        })

    def build_structure(
        self,
        steps: Sequence[dict[str, Any]],
    ) -> dict[str, Any]:
        """Execute a multi-step structure-building sequence.

        Each step dict must contain a ``type`` field.  Supported step types:

        * ``"box"`` — rectangular particle fill (*element*, *x1*, *y1*, *x2*, *y2*)
        * ``"circle"`` — circular particle fill (*element*, *cx*, *cy*, *r*)
        * ``"line"`` — line particle fill (*element*, *x1*, *y1*, *x2*, *y2*)
        * ``"wallBox"`` — rectangular wall (*x1*, *y1*, *x2*, *y2*, *wall*)
        * ``"wallLine"`` — line wall (*x1*, *y1*, *x2*, *y2*, *wall*)
        * ``"flood"`` — flood fill from point (*element*, *x*, *y*)
        * ``"setTemp"`` — set single-cell temperature (*x*, *y*, *value*)
        * ``"setPressure"`` — set single-cell pressure (*x*, *y*, *value*)
        * ``"step"`` — advance simulation (*n*)
        * ``"clear"`` — clear simulation

        Parameters
        ----------
        steps : sequence of dict
            Ordered list of step definitions.

        Returns
        -------
        dict
            Server response with ``steps`` (count) and ``results`` (per-step status).
        """
        return self._post({
            "action": "buildStructure",
            "steps": list(steps),
        })

    def query_region(
        self,
        field: str,
        *,
        x1: int = 0,
        y1: int = 0,
        x2: int | None = None,
        y2: int | None = None,
        step: int = 4,
    ) -> dict[str, Any]:
        """Sample field statistics over a rectangular region.

        Returns min, max, average, and sample count for the given field.

        Parameters
        ----------
        field : str
            Field to sample: ``"temp"`` / ``"temperature"`` or ``"pressure"``.
        x1 : int
            Left edge (default 0).
        y1 : int
            Top edge (default 0).
        x2 : int | None
            Right edge (defaults to grid width - 1).
        y2 : int | None
            Bottom edge (defaults to grid height - 1).
        step : int
            Sample stride (every N-th cell; default 4). Must be >= 1.

        Returns
        -------
        dict
            Server response with ``{min, max, avg, samples}``.
        """
        return self._post({
            "action": "queryRegion",
            "field": field.lower(),
            "x1": x1,
            "y1": y1,
            "x2": x2,
            "y2": y2,
            "step": step,
        })

