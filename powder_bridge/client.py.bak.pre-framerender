    def set_simulation_modes(
        self,
        *,
        edge_mode: int | None = None,
        gravity_mode: int | None = None,
        air_mode: int | None = None,
        paused: bool | None = None,
    ) -> dict[str, Any]:
        if edge_mode is not None and edge_mode not in range(3):
            raise ValueError("edge_mode must be 0, 1, or 2")
        if gravity_mode is not None and gravity_mode not in range(4):
            raise ValueError("gravity_mode must be 0 through 3")
        if air_mode is not None and air_mode not in range(5):
            raise ValueError("air_mode must be 0 through 4")
        if paused is not None and not isinstance(paused, bool):
            raise TypeError("paused must be a bool")
        payload: dict[str, Any] = {"action": "setSimulationModes"}
        if edge_mode is not None:
            payload["edgeMode"] = edge_mode
        if gravity_mode is not None:
            payload["gravityMode"] = gravity_mode
        if air_mode is not None:
            payload["airMode"] = air_mode
        if paused is not None:
            payload["paused"] = paused
        return self._post(payload)

    def set_simulation_mode(
        self,
        *,
        gravity_mode: int | None = None,
        air_mode: int | None = None,
        edge_mode: int | None = None,
        paused: bool | None = None,
        newtonian_gravity: bool | None = None,
    ) -> dict[str, Any]:
        """Configure global simulation modes.

        Any parameter omitted (``None``) leaves the corresponding mode unchanged.

        Parameters
        ----------
        gravity_mode : int | None
            Gravity mode selector (0 = off, 1 = down, 2 = radial, etc.).
        air_mode : int | None
            Air flow mode (0 = off, 1 = on).
        edge_mode : int | None
            Edge behavior mode.
        paused : bool | None
            Pause/resume the simulation.
        newtonian_gravity : bool | None
            Enable/disable Newtonian-style gravity.

        Returns
        -------
        dict
            Server response listing which modes were changed.
        """
        payload: dict[str, Any] = {"action": "setSimulationMode"}
        if gravity_mode is not None:
            payload["gravityMode"] = gravity_mode
        if air_mode is not None:
            payload["airMode"] = air_mode
        if edge_mode is not None:
            payload["edgeMode"] = edge_mode
        if paused is not None:
            payload["paused"] = paused
        if newtonian_gravity is not None:
            payload["newtonianGravity"] = newtonian_gravity
        return self._post(payload)

    def save_region(
        self,
        name: str,
        *,
        x1: int = 0,
        y1: int = 0,
