"""Powder Bridge Python Client Library

A clean, synchronous HTTP client wrapper around The Powder Toy's LLM Powder
Bridge plugin JSON API.

Architecture
------------
The Powder Bridge Lua plugin exposes an HTTP server (default: localhost:9876)
that accepts POST requests with a JSON body containing an ``action`` field and
various parameters. Each request is processed by the Lua handler in
``demo_create_element.lua`` and returns a JSON object of the form::

    {"ok": true, "action": "<name>", ...result fields...}
  or
    {"ok": false, "error": "<reason>", ...details...}

This library maps every supported action to a typed Python method with keyword
arguments matching the JSON field names.  Errors from the server are raised as
descriptive :exc:`PowderError` exceptions; network-level failures raise
:class:`ConnectionError`.

All communication uses only the Python standard library via ``urllib.request``.
No external dependencies are required.

Quick start
-----------
    >>> from powder_bridge.client import PowderClient
    >>> client = PowderClient()
    >>> client.clear()
    >>> client.place_element("IRON", x1=50, y1=50, x2=100, y2=60)
    >>> client.step(50)
    >>> state = client.get_simulation_state()
    >>> print(state["state"]["partCount"])
"""

from __future__ import annotations

import json
import time
import math
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Sequence
from powder_bridge.logging import emit, resolve_correlation_id, summarize_response

XCELLS = 153
YCELLS = 96
SPATIAL_MAX_RESPONSE_BYTES = 262_144
SPATIAL_MAX_PARTICLES = 256
SPATIAL_MAX_PARTICLE_IDS = 256
PARTS_INVENTORY_MAX_LIMIT = 256
PARTS_INVENTORY_MAX_SCAN = 4_096
PARTS_INVENTORY_MAX_SLOTS = 235_008





# ---------------------------------------------------------------------------
# Public exception hierarchy
# ---------------------------------------------------------------------------


class PowderError(Exception):
    """Base exception for Powder Toy API errors."""
    pass


class PowderAPIError(PowderError):
    """Raised when the server returns ok=false with an error message."""
    def __init__(
        self,
        action: str,
        error: str,
        detail: str | None = None,
        response: dict[str, Any] | None = None,
    ) -> None:
        self.action = action
        self.error = error
        self.detail = detail
        self.response = response
        msg = f"{action}: {error}"
        if detail:
            msg += f" — {detail}"
        super().__init__(msg)


class PowderConnectionError(PowderError):
    """Raised when the HTTP connection itself fails."""
    pass
class PowderResponseBudgetError(PowderConnectionError):
    """Raised when a bridge response exceeds the negotiated byte budget."""

    def __init__(self, action: str, limit: int, observed: int) -> None:
        self.action = action
        self.limit = limit
        self.observed = observed
        super().__init__(
            f"{action} response exceeds byte budget {limit} "
            f"(at least {observed} bytes received)"
        )

def _validate_deco_geometry(
    x1: int, y1: int, x2: int, y2: int,
    r: int, g: int, b: int, a: int,
    tool: int, brush: int | None = None,
    rx: int | None = None, ry: int | None = None,
) -> None:
    if not (0 <= x1 <= 611 and 0 <= x2 <= 611 and 0 <= y1 <= 383 and 0 <= y2 <= 383):
        raise ValueError("decoration coordinates outside pixel bounds")
    if not (0 <= r <= 255 and 0 <= g <= 255 and 0 <= b <= 255 and 0 <= a <= 255):
        raise ValueError("decoration color channels must be 0..255")
    if not 0 <= tool <= 6:
        raise ValueError("decoration tool must be 0..6")
    if brush is not None and not 0 <= brush <= 2:
        raise ValueError("decoration brush must be 0..2")
    if rx is not None and not 0 <= rx <= 100:
        raise ValueError("decoration rx must be 0..100")
    if ry is not None and not 0 <= ry <= 100:
        raise ValueError("decoration ry must be 0..100")


# ---------------------------------------------------------------------------
# Core client class
# ---------------------------------------------------------------------------


class PowderClient:
    """Synchronous HTTP client for The Powder Toy's JSON API.

    Connects to the Powder Bridge Lua plugin running on localhost by default.
    Every public method sends a POST request and raises descriptive exceptions
    on failure.

    Parameters
    ----------
    host : str
        Hostname where the Powder Bridge listener runs.
    port : int
        TCP port of the HTTP API (default 9876).
    timeout : float
        Seconds to wait before raising a connection timeout (default 10).

    Examples
    --------
    >>> client = PowderClient(host="localhost", port=9876, timeout=10)
    >>> if client.is_alive():
    ...     print("Connected")
    """
    def __init__(
        self,
        host: str = "127.0.0.1",
        port: int = 9876,
        timeout: float = 10.0,
        token: str | None = None,
    ) -> None:
        self.host = host
        self.port = port
        self.timeout = timeout
        self.token = token or os.environ.get("POWDER_BRIDGE_TOKEN")
        if not self.token:
            token_path = Path("D:/The-Powder-Toy/build/powder-bridge.token")
            if token_path.is_file():
                self.token = token_path.read_text(encoding="utf-8").strip() or None
    # -- internal helpers -----------------------------------------------------

    @property
    def _base_url(self) -> str:
        return f"http://{self.host}:{self.port}"

    def _post(self, payload: dict[str, Any]) -> dict[str, Any]:
        """Send a JSON POST and return the parsed response dict.

        Raises
        ------
        PowderConnectionError
            If the HTTP request cannot be completed.
        PowderAPIError
            If the server responded with ``ok: false``.
        """
        started = time.perf_counter()
        action = str(payload.get("action") or "")
        correlation_id = resolve_correlation_id(payload.get("correlation_id"))
        response_limit: int | None = (
            SPATIAL_MAX_RESPONSE_BYTES
            if action in {"spatialSnapshot", "partsInventory"}
            else None
        )
        if response_limit is not None:
            requested_limit = payload.get("max_response_bytes")
            if type(requested_limit) is int and 1 <= requested_limit <= SPATIAL_MAX_RESPONSE_BYTES:
                response_limit = requested_limit
        error: str | None = None
        runtime_pid: int | None = None
        ok = False
        summary: dict[str, Any] = {}
        try:
            if not self.token:
                raise PowderConnectionError("Powder Bridge token is not configured")
            request_payload = dict(payload)
            request_payload["token"] = self.token
            request_payload["correlation_id"] = correlation_id
            body = json.dumps(request_payload).encode("utf-8")
            req = urllib.request.Request(
                self._base_url,
                data=body,
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            try:
                with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                    if response_limit is None:
                        raw = resp.read().decode("utf-8")
                    else:
                        raw_bytes = resp.read(response_limit + 1)
                        if len(raw_bytes) > response_limit:
                            raise PowderResponseBudgetError(
                                action=action,
                                limit=response_limit,
                                observed=len(raw_bytes),
                            )
                        raw = raw_bytes.decode("utf-8")
            except urllib.error.HTTPError as exc:
                error_limit = response_limit if response_limit is not None else 1024 * 1024
                raw_bytes = exc.read(error_limit + 1)
                if len(raw_bytes) > error_limit:
                    summary = {"ok": False, "action": action, "error_code": "response_too_large", "http_status": exc.code}
                    raise PowderResponseBudgetError(action=action, limit=error_limit, observed=len(raw_bytes))
                raw = raw_bytes.decode("utf-8", errors="replace")
                try:
                    result = json.loads(raw)
                except json.JSONDecodeError as parse_exc:
                    raise PowderConnectionError(f"HTTP {exc.code}: invalid JSON error body") from parse_exc
                if not isinstance(result, dict):
                    raise PowderConnectionError(f"HTTP {exc.code}: non-object error body")
                runtime_pid = result.get("runtime_pid") if type(result.get("runtime_pid")) is int else None
                result.pop("token", None)
                result["correlation_id"] = correlation_id
                summary = summarize_response(result)
                error = str(result.get("error", f"HTTP {exc.code}"))
                raise PowderAPIError(
                    action=str(result.get("action", action)),
                    error=error,
                    detail=str(result.get("detail", "")) or None,
                    response=result,
                )
            except urllib.error.URLError as exc:
                raise PowderConnectionError(str(exc)) from exc
            except OSError as exc:
                raise PowderConnectionError(str(exc)) from exc

            result = json.loads(raw)
            if not isinstance(result, dict):
                raise PowderConnectionError("bridge returned a non-object JSON body")
            runtime_pid = result.get("runtime_pid") if type(result.get("runtime_pid")) is int else None
            result.pop("token", None)
            result["correlation_id"] = correlation_id
            summary = summarize_response(result)
            if not result.get("ok"):
                error = str(result.get("error", ""))
                raise PowderAPIError(
                    action=result.get("action", ""),
                    error=error,
                    detail=str(result.get("detail", "")) or None,
                    response=result,
                )
            ok = True
            return result
        except PowderAPIError as exc:
            error = error or str(exc)
            raise
        except PowderConnectionError as exc:
            error = str(exc)
            raise
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
            raise
        finally:
            emit(
                request=action,
                action=action,
                correlation_id=correlation_id,
                phase="client",
                ok=ok,
                error=error,
                duration_ms=(time.perf_counter() - started) * 1000.0,
                response_summary=summary,
                runtime_pid=runtime_pid,
            )

    # -- connectivity ---------------------------------------------------------

    def is_alive(self) -> bool:
        """Check that the Powder Bridge API is reachable.

        Sends a lightweight ``listElements`` request.

        Returns
        -------
        bool
            ``True`` if the server responds with ``ok: true``, ``False`` otherwise.
        """
        try:
            resp = self._post({"action": "listElements"})
            return resp.get("ok") is True
        except (PowderConnectionError, ValueError):
            return False

    # -- convenience helpers (built on top of full actions) --------------------

    def clear(self) -> dict[str, Any]:
        """Reset the entire simulation (shorthand for ``clear_all``).

        Returns
        -------
        dict
            Server response dict.
        """
        return self.clear_all()

    def step(self, n: int = 1) -> dict[str, Any]:
        """Advance the simulation by *n* frames (shorthand for ``step_sim``).

        Parameters
        ----------
        n : int
            Number of frames to simulate (default 1).

        Returns
        -------
        dict
            Server response dict.
        """
        return self.step_sim(n=n)

    def get_temp(self, x: int, y: int) -> float:
        """Read ambient temperature at grid cell (x, y).

        Parameters
        ----------
        x : int
            Grid X coordinate.
        y : int
            Grid Y coordinate.

        Returns
        -------
        float
            Temperature in Kelvin.

        Raises
        ------
        PowderAPIError
            If the server call fails.
        """
        result = self.get_field(field="temp", x=x, y=y)
        return float(result.get("value", 0))

    def set_temp(self, x: int, y: int, temp: float) -> dict[str, Any]:
        """Set ambient temperature at grid cell (x, y).

        Parameters
        ----------
        x : int
            Grid X coordinate.
        y : int
            Grid Y coordinate.
        temp : float
            Target temperature in Kelvin.

        Returns
        -------
        dict
            Server response dict.
        """
        return self.set_field_region(field="temp", x1=x, y1=y, x2=x, y2=y, value=temp)

    def get_pressure(self, x: int, y: int) -> float:
        """Read ambient pressure at grid cell (x, y).

        Parameters
        ----------
        x : int
            Grid X coordinate.
        y : int
            Grid Y coordinate.

        Returns
        -------
        float
            Pressure value.

        Raises
        ------
        PowderAPIError
            If the server call fails.
        """
        result = self.get_field(field="pressure", x=x, y=y)
        return float(result.get("value", 0))

    def set_pressure(self, x: int, y: int, pressure: float) -> dict[str, Any]:
        """Set ambient pressure at grid cell (x, y).

        Parameters
        ----------
        x : int
            Grid X coordinate.
        y : int
            Grid Y coordinate.
        pressure : float
            Target pressure value.

        Returns
        -------
        dict
            Server response dict.
        """
        return self.set_field_region(
            field="pressure", x1=x, y1=y, x2=x, y2=y, value=pressure,
        )

    # -- 18 HTTP action methods -----------------------------------------------

    def place_element(
        self,
        element: str | int,
        *,
        x1: int = 0,
        y1: int = 0,
        x2: int = 50,
        y2: int = 50,
        method: str = "box",
        radius: int = 10,
    ) -> dict[str, Any]:
        """Place particles into a rectangular box or circle.

        Parameters
        ----------
        element : str | int
            Element name (e.g. ``"IRON"``) or numeric element ID.
        x1 : int
            Left edge of the region (default 0).
        y1 : int
            Top edge of the region (default 0).
        x2 : int
            Right edge of the region (default 50).
        y2 : int
            Bottom edge of the region (default 50).
        method : str
            Placement mode: ``"box"`` (rectangular fill) or ``"circle"``.
        radius : int
            Radius for circle placement (only used when ``method=="circle"``).

        Returns
        -------
        dict
            Server response dict with keys ``{ok, action, placed}``.
        """
        payload: dict[str, Any] = {
            "action": "placeElement",
            "element": element,
            "method": method,
            "x1": x1,
            "y1": y1,
            "x2": x2,
            "y2": y2,
        }
        if method == "circle":
            payload["radius"] = radius
        else:
            payload.pop("radius", None)
        return self._post(payload)

    def place_wall_box(
        self,
        wall: str,
        *,
        x1: int,
        y1: int,
        x2: int,
        y2: int,
    ) -> dict[str, Any]:
        """Place a named wall type in a pixel-space rectangle."""
        return self._post(
            {"action": "placeWallBox", "wall": wall, "x1": x1, "y1": y1, "x2": x2, "y2": y2}
        )
    def place_element_line(self, element: str, *, x1: int, y1: int, x2: int, y2: int) -> dict[str, Any]:
        return self._post({"action": "placeElementLine", "element": element, "x1": x1, "y1": y1, "x2": x2, "y2": y2})

    def place_wall_line(self, wall: str, *, x1: int, y1: int, x2: int, y2: int) -> dict[str, Any]:
        return self._post({"action": "placeWallLine", "wall": wall, "x1": x1, "y1": y1, "x2": x2, "y2": y2})

    def apply_tool_box(
        self,
        tool: str,
        *,
        x1: int,
        y1: int,
        x2: int,
        y2: int,
        strength: float = 1.0,
        brush: int = 0,
        rx: int = 0,
        ry: int = 0,
    ) -> dict[str, Any]:
        """Apply a named native editor tool in a pixel-space rectangle."""
        return self._post(
            {
                "action": "applyToolBox",
                "tool": tool,
                "x1": x1,
                "y1": y1,
                "x2": x2,
                "y2": y2,
                "strength": strength,
                "brush": brush,
                "rx": rx,
                "ry": ry,
            }
        )

    def place_deco_point(
        self,
        *,
        x: int,
        y: int,
        r: int = 255,
        g: int = 255,
        b: int = 255,
        a: int = 255,
        tool: int = 0,
        brush: int = 0,
        rx: int = 5,
        ry: int = 5,
    ) -> dict[str, Any]:
        """Apply a decoration point through `sim.decoBrush` with bound-validated inputs."""
        _validate_deco_geometry(x, y, x, y, r, g, b, a, tool, brush, rx, ry)
        return self._post({
            "action": "placeDecoPoint",
            "x": x, "y": y,
            "r": r, "g": g, "b": b, "a": a,
            "tool": tool, "brush": brush,
            "rx": rx, "ry": ry,
        })

    def set_custom_gravity(self, *, gx: float, gy: float) -> dict[str, Any]:
        """Set the global custom gravity vector via `sim.customGravity`."""
        gx_n = float(gx)
        gy_n = float(gy)
        if not math.isfinite(gx_n) or not math.isfinite(gy_n):
            raise ValueError("custom gravity components must be finite numeric")
        if gx_n < -100 or gx_n > 100 or gy_n < -100 or gy_n > 100:
            raise ValueError("custom gravity components out of safe range")
        return self._post({"action": "setCustomGravity", "gx": gx_n, "gy": gy_n})

    def set_edge_pressure(self, *, value: float) -> dict[str, Any]:
        """Set the boundary pressure via `sim.edgePressure`."""
        value_n = float(value)
        if not math.isfinite(value_n):
            raise ValueError("edge pressure must be finite numeric")
        if value_n < -256 or value_n > 256:
            raise ValueError("edge pressure out of safe range")
        return self._post({"action": "setEdgePressure", "value": value_n})

    def set_edge_velocity(self, *, vx: float, vy: float) -> dict[str, Any]:
        """Set the boundary velocity vector via `sim.edgeVelocity`."""
        vx_n = float(vx)
        vy_n = float(vy)
        if not math.isfinite(vx_n) or not math.isfinite(vy_n):
            raise ValueError("edge velocity components must be finite numeric")
        if vx_n < -256 or vx_n > 256 or vy_n < -256 or vy_n > 256:
            raise ValueError("edge velocity components out of safe range")
        return self._post({"action": "setEdgeVelocity", "vx": vx_n, "vy": vy_n})

    def place_deco_box(
        self,
        *,
        x1: int,
        y1: int,
        x2: int,
        y2: int,
        r: int,
        g: int,
        b: int,
        a: int = 255,
        tool: int = 0,
    ) -> dict[str, Any]:
        _validate_deco_geometry(x1, y1, x2, y2, r, g, b, a, tool)
        return self._post({
            "action": "placeDecoBox",
            "x1": x1, "y1": y1, "x2": x2, "y2": y2,
            "r": r, "g": g, "b": b, "a": a, "tool": tool,
        })
    def place_deco_line(
        self,
        *,
        x1: int, y1: int, x2: int, y2: int,
        r: int, g: int, b: int, a: int = 255,
        tool: int = 0, brush: int = 0, rx: int = 5, ry: int = 5,
    ) -> dict[str, Any]:
        """Apply decoration along a bounded pixel-space line."""
        _validate_deco_geometry(x1, y1, x2, y2, r, g, b, a, tool, brush, rx, ry)
        return self._post({
            "action": "placeDecoLine",
            "x1": x1, "y1": y1, "x2": x2, "y2": y2,
            "r": r, "g": g, "b": b, "a": a,
            "tool": tool, "brush": brush, "rx": rx, "ry": ry,
        })

    def list_stamps(self) -> dict[str, Any]:
        """List available stamps."""
        return self._post({"action": "listStamps"})

    def save_stamp(
        self,
        *,
        x: int,
        y: int,
        width: int,
        height: int,
        include_pressure: bool = True,
    ) -> dict[str, Any]:
        """Save a bounded pixel-space stamp."""
        return self._post({
            "action": "saveStamp",
            "x": x, "y": y, "w": width, "h": height,
            "includePressure": include_pressure,
        })

    def load_stamp(self, name: str, *, x: int = 0, y: int = 0) -> dict[str, Any]:
        """Load a named stamp at a pixel-space position."""
        return self._post({"action": "loadStamp", "name": name, "x": x, "y": y})

    def delete_stamp(self, name: str) -> dict[str, Any]:
        """Delete a named stamp."""
        return self._post({"action": "deleteStamp", "name": name})

    def step_sim(self, n: int = 1) -> dict[str, Any]:
        """Advance the simulation forward by *n* frames.

        Parameters
        ----------
        n : int
            Number of simulation steps (default 1).

        Returns
        -------
        dict
            Server response dict with key ``stepped`` indicating actual frames advanced.
        """
        return self._post({"action": "stepSim", "n": n})

    def get_field(
        self,
        field: str,
        *,
        x: int = 0,
        y: int = 0,
    ) -> dict[str, Any]:
        """Read one bounded temperature or pressure field cell."""
        if field not in {"temp", "temperature", "pressure"}:
            raise ValueError("field must be temp, temperature, or pressure")
        if type(x) is not int or type(y) is not int:
            raise TypeError("field coordinates must be integers")
        if not (0 <= x < XCELLS and 0 <= y < YCELLS):
            raise ValueError("field coordinates outside cell bounds")
        return self._post({"action": "getField", "field": field, "x": x, "y": y})
    def spatial_snapshot(
        self: "PowderClient",
        *,
        space: str,
        x: int | None = None,
        y: int | None = None,
        x1: int | None = None,
        y1: int | None = None,
        x2: int | None = None,
        y2: int | None = None,
        sample_fields: Sequence[str] | None = None,
        sample_stride: int = 4,
        max_samples: int = 4096,
        allow_truncation: bool = False,
        discover_particles: bool = False,
        particle_ids: Sequence[int] | None = None,
        max_particles: int = SPATIAL_MAX_PARTICLES,
        max_response_bytes: int = SPATIAL_MAX_RESPONSE_BYTES,
    ) -> dict[str, Any]:
        """Read one bounded, atomic spatial snapshot from the live runtime.

        Args:
            space: Coordinate domain, exactly ``"pixel"`` or ``"cell"``.
            x, y: Optional point coordinate. A point cannot be combined with a
                rectangle.
            x1, y1, x2, y2: Optional inclusive rectangle coordinates.
            sample_fields: Optional native field names to sample.
            sample_stride: Row-major sample stride from 1 through 128.
            max_samples: Maximum field samples, from 1 through 4096.
            allow_truncation: Permit the runtime to return a marked partial
                result when a configured ceiling would be exceeded.
            discover_particles: Discover particle IDs from bounded pixel pmap and
                photon occupancy samples.
            particle_ids: Optional explicit particle IDs to include in the bounded
                particle records. Duplicate IDs are removed before sending.
            max_particles: Maximum particle records, from 1 through 256.
            max_response_bytes: Maximum encoded response size, from 4096 through
                262144 bytes.

        Returns:
            The single ``spatialSnapshot`` bridge response, including its
            correlation ID, evidence, provenance, and truncation metadata.

        Raises:
            TypeError: If coordinates or limits have the wrong type.
            ValueError: If the domain, region, or configured limits are
                outside the atomic action contract.
            PowderAPIError: If the runtime rejects the bounded request.
            PowderConnectionError: If the bridge cannot be reached.
        """
        if space not in {"pixel", "cell"}:
            raise ValueError("space must be exactly pixel or cell")

        rectangle = (x1, y1, x2, y2)
        point_supplied = x is not None or y is not None
        rectangle_supplied = any(value is not None for value in rectangle)

        def require_int(value: int | None, name: str) -> int:
            if type(value) is not int:
                raise TypeError(f"{name} must be an integer")
            return value

        if point_supplied and rectangle_supplied:
            raise ValueError("provide x and y or x1, y1, x2, y2, not both")
        if point_supplied:
            if x is None or y is None:
                raise ValueError("x and y are required together")
            normalized_region = {
                "x": require_int(x, "x"),
                "y": require_int(y, "y"),
            }
            bounds_x = 611 if space == "pixel" else 152
            bounds_y = 383 if space == "pixel" else 95
            if not (0 <= normalized_region["x"] <= bounds_x):
                raise ValueError(f"x coordinate outside {space} bounds")
            if not (0 <= normalized_region["y"] <= bounds_y):
                raise ValueError(f"y coordinate outside {space} bounds")
            area = 1
        else:
            if not all(value is not None for value in rectangle):
                raise ValueError("x1, y1, x2, and y2 are required together")
            normalized_region = {
                "x1": require_int(x1, "x1"),
                "y1": require_int(y1, "y1"),
                "x2": require_int(x2, "x2"),
                "y2": require_int(y2, "y2"),
            }
            bounds_x = 611 if space == "pixel" else 152
            bounds_y = 383 if space == "pixel" else 95
            if not (
                0 <= normalized_region["x1"] <= normalized_region["x2"] <= bounds_x
            ):
                raise ValueError(f"x coordinates outside {space} bounds")
            if not (
                0 <= normalized_region["y1"] <= normalized_region["y2"] <= bounds_y
            ):
                raise ValueError(f"y coordinates outside {space} bounds")
            area = (
                normalized_region["x2"] - normalized_region["x1"] + 1
            ) * (normalized_region["y2"] - normalized_region["y1"] + 1)
        if area > 12_288:
            raise ValueError("region area exceeds limit 12288")

        if type(sample_stride) is not int:
            raise TypeError("sample_stride must be an integer")
        if not 1 <= sample_stride <= 128:
            raise ValueError("sample_stride must be between 1 and 128")
        if type(max_samples) is not int:
            raise TypeError("max_samples must be an integer")
        if not 1 <= max_samples <= 4_096:
            raise ValueError("max_samples must be between 1 and 4096")
        if type(allow_truncation) is not bool:
            raise TypeError("allow_truncation must be a boolean")
        if type(discover_particles) is not bool:
            raise TypeError("discover_particles must be a boolean")
        if discover_particles and space != "pixel":
            raise ValueError("discover_particles requires pixel coordinates")
        if type(max_particles) is not int:
            raise TypeError("max_particles must be an integer")
        if not 1 <= max_particles <= SPATIAL_MAX_PARTICLES:
            raise ValueError(
                f"max_particles must be between 1 and {SPATIAL_MAX_PARTICLES}"
            )
        if type(max_response_bytes) is not int:
            raise TypeError("max_response_bytes must be an integer")
        if not 4096 <= max_response_bytes <= SPATIAL_MAX_RESPONSE_BYTES:
            raise ValueError(
                "max_response_bytes must be between 4096 and "
                f"{SPATIAL_MAX_RESPONSE_BYTES}"
            )
        normalized_particle_ids: list[int] = []
        if particle_ids is not None:
            if isinstance(particle_ids, (str, bytes)):
                raise TypeError("particle_ids must be a sequence of integers")
            try:
                raw_particle_ids = list(particle_ids)
            except TypeError as exc:
                raise TypeError("particle_ids must be a sequence of integers") from exc
            seen_particle_ids: set[int] = set()
            for particle_id in raw_particle_ids:
                if type(particle_id) is not int:
                    raise TypeError("particle_ids entries must be integers")
                if particle_id < 0:
                    raise ValueError("particle_ids entries must be non-negative")
                if particle_id not in seen_particle_ids:
                    seen_particle_ids.add(particle_id)
                    normalized_particle_ids.append(particle_id)
            if len(normalized_particle_ids) > SPATIAL_MAX_PARTICLE_IDS:
                raise ValueError(
                    "particle_ids cannot exceed "
                    f"{SPATIAL_MAX_PARTICLE_IDS} entries"
                )
            if normalized_particle_ids and space != "pixel":
                raise ValueError("particle_ids require pixel coordinates")

        payload: dict[str, Any] = {
            "action": "spatialSnapshot",
            "space": space,
            **normalized_region,
            "stride": sample_stride,
            "max_samples": max_samples,
            "allow_truncation": allow_truncation,
            "discover_particles": discover_particles,
            "particle_ids": normalized_particle_ids,
            "max_particles": max_particles,
            "max_response_bytes": max_response_bytes,
        }
        if sample_fields is not None:
            if isinstance(sample_fields, (str, bytes)):
                raise TypeError("sample_fields must be a sequence of strings")
            fields = list(sample_fields)
            if len(fields) > 2:
                raise ValueError("sample_fields cannot contain more than two entries")
            if any(not isinstance(field, str) for field in fields):
                raise TypeError("sample_fields entries must be strings")
            payload["fields"] = fields
        elif space == "pixel":
            payload["fields"] = []

        return self._post(payload)


    def parts_inventory(
        self,
        *,
        cursor: int = 0,
        limit: int = PARTS_INVENTORY_MAX_LIMIT,
        max_scan: int = PARTS_INVENTORY_MAX_SCAN,
        x1: int | None = None,
        y1: int | None = None,
        x2: int | None = None,
        y2: int | None = None,
        type: int | None = None,
    ) -> dict[str, Any]:
        """Read one bounded page of live particle slots.

        Args:
            cursor: Raw particle-slot cursor. It advances by ``scanned`` and
                is not a returned-record index.
            limit: Maximum matching records to return, from 1 through 256.
            max_scan: Maximum raw slots to visit, from 1 through 4096.
            x1, y1, x2, y2: Optional inclusive pixel-region bounds. All four
                coordinates must be supplied together.
            type: Optional numeric element ID filter.

        Returns:
            The authenticated ``partsInventory`` response. Records contain only
            ``id``, ``type``, ``x``, ``y``, ``temp``, ``life``, ``vx``, and
            ``vy``; pagination and evidence metadata are returned by the bridge.

        Examples:
            >>> page = client.parts_inventory(limit=32, max_scan=512)
            >>> page["records"]

        Raises:
            TypeError: If a cursor, limit, scan budget, coordinate, or filter
                has the wrong type.
            ValueError: If a bound, region, or pagination limit is invalid.
            PowderAPIError: If the bridge rejects the bounded request.
            PowderConnectionError: If the bridge cannot be reached.
        """
        def require_int(value: Any, name: str) -> int:
            if isinstance(value, bool) or not isinstance(value, int):
                raise TypeError(f"{name} must be an integer")
            return value

        cursor = require_int(cursor, "cursor")
        limit = require_int(limit, "limit")
        max_scan = require_int(max_scan, "max_scan")
        if not 0 <= cursor <= PARTS_INVENTORY_MAX_SLOTS:
            raise ValueError(
                "cursor must be between 0 and "
                f"{PARTS_INVENTORY_MAX_SLOTS}"
            )
        if not 1 <= limit <= PARTS_INVENTORY_MAX_LIMIT:
            raise ValueError(
                f"limit must be between 1 and {PARTS_INVENTORY_MAX_LIMIT}"
            )
        if not 1 <= max_scan <= PARTS_INVENTORY_MAX_SCAN:
            raise ValueError(
                f"max_scan must be between 1 and {PARTS_INVENTORY_MAX_SCAN}"
            )

        coordinates = (x1, y1, x2, y2)
        if any(value is not None for value in coordinates):
            if not all(value is not None for value in coordinates):
                raise ValueError("x1, y1, x2, and y2 are required together")
            region = {
                "x1": require_int(x1, "x1"),
                "y1": require_int(y1, "y1"),
                "x2": require_int(x2, "x2"),
                "y2": require_int(y2, "y2"),
            }
            if not (0 <= region["x1"] <= region["x2"] < 612):
                raise ValueError("x coordinates outside pixel bounds")
            if not (0 <= region["y1"] <= region["y2"] < 384):
                raise ValueError("y coordinates outside pixel bounds")
        else:
            region = {}

        if type is not None:
            type = require_int(type, "type")
            if type < 0:
                raise ValueError("type must be non-negative")

        payload: dict[str, Any] = {
            "action": "partsInventory",
            "cursor": cursor,
            "limit": limit,
            "max_scan": max_scan,
            **region,
        }
        if type is not None:
            payload["type"] = type
        return self._post(payload)


