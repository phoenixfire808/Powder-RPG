if __name__ == "__main__":

    print("=" * 60)
    print("Powder Bridge Client — Usage Examples")
    print("=" * 60)

    host = sys.argv[1] if len(sys.argv) > 1 else "localhost"
    port = int(sys.argv[2]) if len(sys.argv) > 2 else 9876
    timeout = float(sys.argv[3]) if len(sys.argv) > 3 else 10.0

    client = PowderClient(host=host, port=port, timeout=timeout)

    # 1. Verify connection
    print(f"\n[1] Checking connection to {host}:{port} ...")
    if client.is_alive():
        print("    Connected — server is alive.")
    else:
        print("    ERROR: could not reach server.")
        print("    Start The Powder Toy with autorun.lua enabled.")
        sys.exit(1)

    # 2. List available elements
    print("\n[2] Listing elements (first 10) ...")
    elements = client.list_elements()
    for elem in elements.get("elements", [])[:10]:
        print(f"    id={elem['id']:>5}  {elem['name']}  ({elem['identifier']})")
    print(f"    ... total {elements.get('count', 0)} elements")

    # 3. Clear simulation
    print("\n[3] Clearing simulation ...")
    r = client.clear()
    print(f"    cleared: {r}")

    # 4. Create a custom element
    print("\n[4] Creating custom element 'GLOWROCK' ...")
    glowrock = client.create_element(
        name="GLOWROCK",
        group="POWDERBRIDGE",
        properties={
            "Name": "Glowrock",
            "Type": 1,                  # elem.TYPE_PART
            "Colour": [200, 100, 255, 0],  # purple, no alpha
            "Advection": 0,
            "Gravity": 1,
            "Diffusion": 0.5,
            "HotAir": 0.2,
            "Flammable": 0,
            "Explosive": 0,
            "Temperature": 300,
        },
    )
    eid = glowrock.get("id")
    if eid is not None:
        print(f"    created id={eid}  ({glowrock.get('identifier')})")
    else:
        print(f"    WARNING: creation failed: {glowrock}")

    # 5. Place some particles
    if eid is not None:
        print(f"\n[5] Placing {eid} in a box at (50,50)-(150,80) ...")
        r = client.place_element(eid, x1=50, y1=50, x2=150, y2=80)
        print(f"    placed: {r}")

    # Also place a circle of water for contrast
    print("  Placing WATER in a circle at (200,60), r=15 ...")
    r = client.place_circle("WATER", cx=200, cy=60, radius=15)
    print(f"    placed: {r}")

    # 6. Read initial temperature
    print("\n[6] Reading ambient temperature at (100,65) ...")
    temp_before = client.get_temp(100, 65)
    print(f"    temp = {temp_before:.2f} K")

    # 7. Heat the glowrock region
    print("[7] Heating region (50,50)-(150,80) to 500K ...")
    r = client.set_field_region("temp", x1=50, y1=50, x2=150, y2=80, value=500)
    print(f"    set {r.get('cells')} cells")

    # 8. Run the simulation
    print("[8] Running 100 simulation steps ...")
    r = client.step(100)
    print(f"    stepped {r.get('stepped')} frames")

    # 9. Query temperature after stepping
    print("[9] Querying temperature stats in region (50,50)-(150,80) ...")
    stats = client.query_region("temp", x1=50, y1=50, x2=150, y2=80)
    print(f"    min={stats.get('min'):.1f}K  max={stats.get('max'):.1f}K  "
          f"avg={stats.get('avg'):.1f}K  samples={stats.get('samples')}")

    # 10. Get full state
    print("\n[10] Getting full simulation state ...")
    state = client.get_simulation_state()
    s = state.get("state", {})
    print(f"    particles: {s.get('partCount')}")
    print(f"    paused:    {s.get('paused')}")
    print(f"    gravity:   {s.get('gravityMode')}")
    print(f"    air mode:  {s.get('airMode')}")
    print(f"    ambient T: {s.get('ambientTemp'):.1f}K")

    # 11. Execute Lua to find a particle
    print("\n[11] Executing Lua: sim.partCount() ...")
    lua_r = client.execute_lua("return sim.partCount()")
    print(f"    result: {lua_r.get('result')}")

    # 12. Save / load region round-trip
    print("\n[12] Saving region as 'test_stamp' ...")
    client.save_region("test_stamp", x1=0, y1=0)
    print("  Loading it back at (0,0) ...")
    client.load_region("test_stamp")
    print("  done")

    print("\n" + "=" * 60)
    print("All examples complete.")
    print("=" * 60)
